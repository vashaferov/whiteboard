# Скопируйте в .env и поменяйте значения перед публикацией

# Учётные записи и сессии
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin-change-me
ADMIN_NAME=Администратор
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
PASSWORD_ROUNDS=12
AUTH_LOGIN_PER_MINUTE=10
AUTH_REGISTER_PER_MINUTE=5

# Логическая доска
BOARD_WIDTH=1600
BOARD_HEIGHT=900

# Лимиты
MAX_UPLOAD_MB=5
ROOM_TTL_DAYS=30
MAX_OBJECTS_PER_ROOM=20000
MAX_WORKSPACES_PER_ROOM=50
WORKSPACE_MOVE_TIMEOUT_SECONDS=2.0
RATE_LIMIT_POINTS_PER_SEC=60
RATE_LIMIT_CURSORS_PER_SEC=25
RATE_LIMIT_MESSAGES_PER_SEC=40

# Пути (по умолчанию — папки в корне проекта)
# DATA_DIR=./data
# UPLOADS_DIR=./uploads
# FRONTEND_DIR=./frontend

# Redis: пусто — один инстанс, состояние в памяти
# REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=whiteboard
PRESENCE_TTL_SECONDS=45
HEARTBEAT_SECONDS=15

# S3 / SeaweedFS: пустой bucket — локальная папка uploads.
# S3_PUBLIC_READ=false: ACL объекта не меняется; публичное чтение в compose
# обеспечивает identity "anonymous" (Read) в конфиге SeaweedFS.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
S3_USE_SSL=false
S3_PUBLIC_READ=false
S3_CREATE_BUCKET=true

# Наблюдаемость
LOG_JSON=false
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
METRICS_ENABLED=true

# Production-домен и ключи S3 для docker-compose.prod.yml
# DOMAIN=board.example.com
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me-too

# VDS рядом с существующими контейнерами (docker-compose.vds.yml).
# Доска живёт на основном домене, но на отдельном TLS-порту; 80/443 остаются
# у существующего reverse proxy. Сертификат выпускает собственный certbot
# через общий webroot (порт 80 обслуживает существующий nginx) и хранит его
# в TLS_CERTS_DIR; ACME-челленджи пишутся в CERTBOT_WEBROOT.
# GHCR_OWNER и GHCR_REPO задают образ: ghcr.io/<owner>/<repo>:<WB_TAG>.
# COOKIE_SECURE=true обязателен.
# S3_BUCKET оставьте пустым: картинки будут в томе uploads и на /uploads.
# GHCR_OWNER=your-github-login
# GHCR_REPO=whiteboard
# WB_TAG=latest
# DOMAIN=mediahlg.ru
# WB_HTTPS_PORT=8443
# TLS_CERTS_DIR=/home/your-user/whiteboard-certs
# CERTBOT_EMAIL=admin@example.com
# CERTBOT_WEBROOT=/home/your-user/duty/certbot-www
# WB_PORT=8010
# WB_BIND=127.0.0.1
# COMPOSE_PROJECT_NAME=whiteboard-prod

